{
    "name": "glueful/storage-s3",
    "description": "AWS S3 and S3-compatible storage driver for the Glueful framework.",
    "type": "glueful-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Tawiah Sowah",
            "email": "michael@glueful.dev"
        }
    ],
    "keywords": [
        "storage",
        "s3",
        "r2",
        "minio",
        "spaces",
        "wasabi",
        "flysystem",
        "glueful"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "glueful/framework": "^1.56.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "homepage": "https://github.com/glueful/storage-s3",
    "autoload": {
        "psr-4": {
            "Glueful\\Extensions\\StorageS3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Glueful\\Extensions\\StorageS3\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist",
        "phpcbf": "vendor/bin/phpcbf --standard=PSR12 src",
        "phpcs": "vendor/bin/phpcs --standard=PSR12 src",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "glueful": {
            "name": "StorageS3",
            "displayName": "S3 Storage Driver",
            "description": "AWS S3 and S3-compatible storage driver (R2/MinIO/Spaces/Wasabi presets).",
            "version": "1.0.1",
            "categories": [
                "storage"
            ],
            "publisher": "glueful-team",
            "provider": "Glueful\\Extensions\\StorageS3\\StorageS3ServiceProvider",
            "requires": {
                "glueful": ">=1.56.0",
                "extensions": []
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
